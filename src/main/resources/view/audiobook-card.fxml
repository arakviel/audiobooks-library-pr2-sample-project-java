<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arakviel.presentation.controller.AudiobookCardController">
   <children>
      <VBox fx:id="cardContainer" styleClass="audiobook-card">
         <children>
            <!-- Обкладинка аудіокниги -->
            <StackPane styleClass="cover-container">
               <children>
                  <VBox alignment="CENTER" styleClass="cover-placeholder">
                     <children>
                        <Label styleClass="cover-icon" text="📚">
                           <font>
                              <Font size="48.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <!-- Кнопка відтворення -->
                  <Button fx:id="playButton" styleClass="play-button" text="▶" visible="false">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Button>
               </children>
            </StackPane>
            
            <!-- Інформація про аудіокнигу -->
            <VBox styleClass="card-info">
               <children>
                  <!-- Назва -->
                  <Label fx:id="titleLabel" styleClass="card-title" text="Назва аудіокниги" wrapText="true">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <!-- Автор -->
                  <Label fx:id="authorLabel" styleClass="card-author" text="Автор">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  
                  <!-- Жанр -->
                  <Label fx:id="genreLabel" styleClass="card-genre" text="Жанр">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  
                  <!-- Додаткова інформація -->
                  <HBox spacing="10.0" styleClass="card-details">
                     <children>
                        <Label fx:id="durationLabel" styleClass="card-duration" text="0 хв">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                        <Label styleClass="card-separator" text="•">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="yearLabel" styleClass="card-year" text="2024">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </VBox>
            
            <!-- Кнопки дій -->
            <HBox alignment="CENTER" spacing="10.0" styleClass="card-actions">
               <children>
                  <Button fx:id="editButton" onAction="#handleEdit" styleClass="card-action-button" text="✏️" />
                  <Button fx:id="deleteButton" onAction="#handleDelete" styleClass="card-action-button" text="🗑️" />
                  <Button fx:id="infoButton" onAction="#handleInfo" styleClass="card-action-button" text="ℹ️" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
